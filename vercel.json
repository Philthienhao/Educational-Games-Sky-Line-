{
  "headers": [
    {
      "source": "/textbooks/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        },
        {
          "key": "Accept-Ranges",
          "value": "bytes"
        }
      ]
    },
    {
      "source": "/(.*\\.pdf)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        },
        {
          "key": "Accept-Ranges",
          "value": "bytes"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/((?!assets/|textbooks/|.*\\.(?:pdf|png|jpg|jpeg|svg|ico|js|css|json|mp4|webm|mov)$).*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/((?!assets/|textbooks/|textbook_texts/|.*\\.(?:pdf|txt|png|jpg|jpeg|svg|ico|js|css|json|mp4|webm|mov)$).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/storage?userId=system_keepalive&dataType=ping",
      "schedule": "0 0 */3 * *"
    }
  ]
}
